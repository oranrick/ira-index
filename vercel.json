{
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }],
  "crons": [
    { "path": "/api/cron/daily-all",    "schedule": "0 13 * * *" },
    { "path": "/api/cron/daily-all-pm", "schedule": "0 20 * * *" }
  ],
  "functions": {
    "api/cron/daily-all.js":    { "maxDuration": 300 },
    "api/cron/daily-all-pm.js": { "maxDuration": 300 }
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
